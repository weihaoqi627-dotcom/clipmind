{
  "name": "clipmind",
  "version": "1.0.0",
  "description": "ClipMind / 剪意 — AI 智能视频剪辑",
  "main": "main.js",
  "scripts": {
    "dev:renderer": "node scripts/run-electron.js dev-all",
    "dev:electron": "node scripts/run-electron.js dev",
    "dev": "node scripts/run-electron.js dev-all",
    "build:renderer": "vite build",
    "build:package": "node scripts/build-portable.js",
    "preview": "node scripts/run-electron.js preview"
  },
  "build": {
    "appId": "com.clipmind.app",
    "productName": "ClipMind",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "python_runtime",
        "to": "python_runtime"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "director",
        "to": "director",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://clipmind.oss-cn-hongkong.aliyuncs.com",
      "channel": "latest"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^35.1.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@electron/fuses": "^2.1.1",
    "electron-updater": "^6.8.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  }
}
