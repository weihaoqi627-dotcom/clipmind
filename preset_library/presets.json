      "template": {
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:transparent;overflow:hidden;width:1280px;height:720px}\n#root{position:relative;width:1280px;height:720px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(ellipse,rgba(0,0,0,0.1) 0%,transparent 70%)}\n.type-wrap{position:relative}\n.main-text{font-family:{font_family_primary};font-size:56px;font-weight:500;color:#fff;\n  text-shadow:0 2px 8px rgba(0,0,0,0.2);white-space:nowrap;overflow:hidden;border-right:3px solid rgba(255,255,255,0.7);width:0;opacity:0}\n</style></head><body>\n<div id=\"root\" data-composition-id=\"main\" data-duration=\"3\" data-width=\"1280\" data-height=\"720\">\n<div class=\"type-wrap\"><div class=\"main-text\">{text}</div></div>\n</div>\n<script>\nwindow.__timelines[\"main\"]=gsap.timeline({paused:true});\nconst tl=window.__timelines[\"main\"];\nconst txt='{text}';\nconst chars=txt.length;\nconst charTime=0.08;\nconst totalTyping=chars*charTime;\ntl.set('.main-text',{opacity:1})\ntl.to('.main-text',{width:txt.length*40,duration:totalTyping,ease:'steps('+chars+')'},0)\ntl.to('.main-text',{borderColor:'transparent',duration:0.3,repeat:-1,yoyo:true,ease:'steps(1)'},0)\ntl.to('.main-text',{opacity:0,duration:0.3,ease:'power2.in'},2.6)\nwindow.__hf={duration:3,seek:function(t){window.__timelines[\"main\"].seek(t,true)}}\n</script></body></html>",
        "default_duration": 3.0
      },
      "created_at": "2026-05-27"
    },
