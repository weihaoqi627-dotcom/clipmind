        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:transparent;overflow:hidden;width:1280px;height:720px}\n#root{position:relative;width:1280px;height:720px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(ellipse,rgba(0,0,0,0.3) 0%,transparent 70%)}\n.main-text{font-family:{font_family_primary};font-size:80px;font-weight:900;letter-spacing:4px;\n  background:linear-gradient(135deg,#ff6b6b,#feca57,#48dbfb,#ff9ff3);\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 0 20px rgba(255,107,107,0.6)) drop-shadow(0 0 60px rgba(72,219,251,0.3));\n  opacity:0;transform:scale(0.7)}\n</style></head><body>\n<div id=\"root\" data-composition-id=\"main\" data-duration=\"3\" data-width=\"1280\" data-height=\"720\">\n<div class=\"main-text\">{text}</div>\n</div>\n<script>\nwindow.__timelines[\"main\"]=gsap.timeline({paused:true});\nconst tl=window.__timelines[\"main\"];\ntl.set('.main-text',{opacity:0,scale:0.7})\ntl.to('.main-text',{opacity:1,scale:1,duration:0.6,ease:'back.out(2)'},0)\ntl.to('.main-text',{filter:'drop-shadow(0 0 30px rgba(255,107,107,0.8)) drop-shadow(0 0 80px rgba(72,219,251,0.4))',duration:0.5,yoyo:true,repeat:-1,ease:'sine.inOut'},0.5)\ntl.to('.main-text',{opacity:0,scale:0.8,duration:0.3,ease:'power2.in'},2.6)\nwindow.__hf={duration:3,seek:function(t){window.__timelines[\"main\"].seek(t,true)}}\n</script></body></html>",
        "default_duration": 3.0
