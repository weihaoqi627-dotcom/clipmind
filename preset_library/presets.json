      "params": ["text", "font_family_primary", "duration"],
      "template": {
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:transparent;overflow:hidden;width:1280px;height:720px}\n#root{position:relative;width:1280px;height:720px;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.c{display:inline-block;font-family:{font_family_primary};font-size:72px;font-weight:800;\n  text-shadow:0 2px 10px rgba(0,0,0,0.2);opacity:0;transform:scale(0) rotate(-15deg)}\n</style></head><body>\n<div id=\"root\" data-composition-id=\"main\" data-duration=\"2.5\" data-width=\"1280\" data-height=\"720\">\n<div class=\"c\">{text}</div>\n</div>\n<script>\nwindow.__timelines[\"main\"]=gsap.timeline({paused:true});\nconst tl=window.__timelines[\"main\"];\nconst colors=['#ff6b6b','#feca57','#48dbfb','#ff9ff3','#54a0ff','#5f27cd','#01a3a4','#f368e0'];\ntl.set('.c',{opacity:0,scale:0,rotation:-15})\ntl.to('.c',{opacity:1,scale:1,rotation:0,duration:0.5,ease:'back.out(3)'},0)\ntl.to('.c',{color:colors[0],duration:0.15},0.15)\ntl.to('.c',{color:colors[1],duration:0.15},0.3)\ntl.to('.c',{color:colors[2],duration:0.15},0.45)\ntl.to('.c',{color:colors[3],duration:0.15},0.6)\ntl.to('.c',{color:colors[4],duration:0.15},0.75)\ntl.to('.c',{color:'#fff',duration:0.1},0.9)\ntl.to('.c',{opacity:0,scale:0.8,duration:0.3,ease:'power2.in'},2.1)\nwindow.__hf={duration:2.5,seek:function(t){window.__timelines[\"main\"].seek(t,true)}}\n</script></body></html>",
        "default_duration": 2.5
      },
      "created_at": "2026-05-27"
    },
